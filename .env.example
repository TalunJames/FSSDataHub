# Read by docker-compose.yml (env_file) for local Docker runs. The TrueNAS
# Custom App path ignores this file — put env vars in the app's YAML instead.
# API keys are better entered on the Settings page; env vars only seed first boot.
TAX_DATABASE_DATA=/data
TZ=America/Los_Angeles
COLLECTOR_PORT=8080
COLLECTOR_USER=taxdb
# COLLECTOR_PASSWORD=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLAMA_BASE_URL=http://host.docker.internal:11434
# COLLECTOR_PROVIDER=llama
# SEARCH_API_KEY=          # Brave Search API key; without one the crawler
                           # scrapes result pages and gets throttled
